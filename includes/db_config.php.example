<?php
/**
 * Database Configuration for HIFIS - EXAMPLE FILE
 * 
 * INSTRUCTIONS:
 * 1. Copy this file to db_config.php in the same directory
 * 2. Update the database credentials below with your actual values
 * 3. DO NOT commit db_config.php to version control (it's in .gitignore)
 */

// Database credentials
define('DB_HOST', 'localhost');        // Database host (usually 'localhost')
define('DB_USER', 'root');             // Your MySQL username
define('DB_PASS', '');                 // Your MySQL password
define('DB_NAME', 'hifis_db');         // Database name

// Create database connection
function getDBConnection() {
    try {
        $conn = new mysqli(DB_HOST, DB_USER, DB_PASS, DB_NAME);
        
        if ($conn->connect_error) {
            die("Connection failed: " . $conn->connect_error);
        }
        
        $conn->set_charset("utf8mb4");
        return $conn;
    } catch (Exception $e) {
        die("Database connection error: " . $e->getMessage());
    }
}

// Close database connection
function closeDBConnection($conn) {
    if ($conn) {
        $conn->close();
    }
}
?>
